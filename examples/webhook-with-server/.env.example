# Copy to .env (git-ignored) and change the values. Placeholders only.

# Password of the server's SuperUser account (admin). Required; pick a long random one.
SUPERUSER_PASSWORD=change-me-superuser

# Connect password for everyone, bot included. Leave empty for an open test server.
SERVER_PASSWORD=

# Host ports, both bound to 127.0.0.1 only.
MUMBLE_PORT=64738
HTTP_PORT=8080

# Log level of the bot: error, warn, info or debug.
RUST_LOG=info
