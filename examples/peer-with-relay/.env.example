# Copy to .env (git-ignored) and change the values. Placeholders only.

# Password of the server's SuperUser account (admin). Required; pick a long random one.
SUPERUSER_PASSWORD=change-me-superuser

# Secret between the peer bot and the relay API, at least 32 characters:
# openssl rand -hex 32
PEER_API_SECRET=change-me-to-at-least-32-random-characters

# Connect password for everyone, bot included. Leave empty for an open test server.
SERVER_PASSWORD=

# Mumble host port (127.0.0.1 only) and the address the relay ports bind to on the host.
MUMBLE_PORT=64738
RELAY_BIND=127.0.0.1

# The relay image (Mumcord/mumpeer).
MUMPEER_IMAGE=ghcr.io/mumcord/mumpeer:0.1.0

# Log level: error, warn, info or debug.
RUST_LOG=info
