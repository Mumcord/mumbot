# Copy to .env (git-ignored). Placeholders only; in CI, generate the password per run, for
# example: printf 'SUPERUSER_PASSWORD=%s\n' "$(openssl rand -hex 16)" > .env

# Password of the throwaway server's SuperUser account, used by --superuser steps.
SUPERUSER_PASSWORD=change-me-superuser

# Host port of the server, bound to 127.0.0.1 only.
MUMBLE_PORT=64738

# Log level of the test bot: error, warn, info or debug. Results go to stdout either way.
RUST_LOG=warn
