# Copy to .env (git-ignored) and change the values. Placeholders only.

# Connect password of your Mumble server. Leave empty if it has none.
SERVER_PASSWORD=

# Modules to run, comma-separated. Empty means the config's [modules] enabled list decides.
MUMBOT_MODULES=

# Host port of the webhook API, bound to 127.0.0.1 only.
HTTP_PORT=8080

# Log level of the bot: error, warn, info or debug. No level logs message texts.
RUST_LOG=info
